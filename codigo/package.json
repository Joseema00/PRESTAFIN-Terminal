{
  "name": "prestafin-terminal",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "node scripts/prepare-desktop.mjs && vite build --config vite.desktop.config.ts",
    "desktop:start": "electron .",
    "desktop:open": "npm run desktop:build && npm run desktop:start",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis portable --x64 --publish never",
    "desktop:check": "node scripts/prepare-desktop.mjs && node scripts/check-desktop.mjs && node --test desktop/tests/*.test.mjs",
    "desktop:typecheck": "tsc -p tsconfig.desktop.json --noEmit",
    "dev": "npm run desktop:open",
    "build": "npm run desktop:build",
    "preview": "npm run desktop:start",
    "test": "npm run desktop:check",
    "desktop:folder": "npm run desktop:build && electron-builder --win --dir --x64 --publish never"
  },
  "devDependencies": {
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.18",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "happy-dom": "^21.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "vite": "^8.1.5"
  },
  "version": "0.7.0",
  "description": "Terminal de escritorio de Prestafin",
  "author": "Prestafin",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "build": {
    "appId": "tech.prestafin.terminal",
    "productName": "Prestafin Terminal",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/*.mjs",
      "desktop/*.cjs",
      "desktop/icon.ico",
      "desktop-runtime/**/*",
      "dist-desktop/**/*",
      "src/assets/*.png",
      "package.json",
      "!**/.env*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prestafin Terminal",
      "artifactName": "Prestafin-Terminal-${version}-Instalador-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Prestafin-Terminal-${version}-Portable-${arch}.${ext}"
    }
  }
}
